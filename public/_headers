/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: DENY

  Cross-Origin-Opener-Policy keeps the application isolated
  from unrelated browsing contexts.

  Cross-Origin-Resource-Policy is same-origin because the
  application's assets are served from the same domain.
  This also keeps the current CSP intentionally simple.
  Cross-origin assets should not be introduced without
  deliberately updating this policy.
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

  CSP:
  - React/Vite scripts remain same-origin.
  - Google Fonts are explicitly permitted.
  - Three.js assets are same-origin.
  - Blob/data sources are permitted where browser rendering
    requires them.
  - No arbitrary frames, objects, forms, cameras, microphones,
    or geolocation access.
*/
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'