{
  "project": "Antarctic Labs",
  "version": "1.0.0",
  "status": "production-foundation",
  "canonical_url": "https://antarctic-labs.com/",
  "repository": "https://github.com/Joshuv-AI/antarctic-labs",
  "branch": "main",
  "deployment": {
    "provider": "Cloudflare Pages",
    "build_command": "npm run build",
    "output_directory": "dist",
    "root_directory": ".",
    "production_branch": "main",
    "automatic_deployments": true
  },
  "stack": {
    "frontend": "React 19",
    "bundler": "Vite",
    "graphics": "ThreeUI (iframe-isolated WebGL2 + Canvas 2D)",
    "animation": "GSAP",
    "rendering": "WebGL2 + Canvas 2D inside sandboxed iframes",
    "shaders": "GLSL ES 3.00 + custom particle network"
  },
  "source": {
    "application": "src/main.jsx",
    "scene": "src/PolarScene.jsx",
    "styles": "src/styles.css"
  },
  "routes": [
    "/",
    "/project-01",
    "/project-02",
    "/about"
  ],
  "runtime_assets": {
    "root": "public/assets",
    "sky": "public/assets/hdr/daysky-8k-hdr-4k.jpg",
    "distance_mountain": "public/assets/models/mountains/chalaadi.fbx",
    "optional_hero_mountain": "public/assets/models/mountains/single-mountain-snow.glb",
    "optional_hero_source": "Aura_Borealis_.blend"
  },
  "environment": {
    "sky": true,
    "hero_mountain": "optional",
    "distance_mountain": true,
    "ice": true,
    "snow": true,
    "rock": true,
    "water": true,
    "clouds": true,
    "mist": true,
    "atmospheric_fog": true,
    "stars": true,
    "aurora": "temporary_procedural_until_hero_asset_is_available"
  },
  "experience": {
    "narrative": [
      "ARRIVAL",
      "DESCENT",
      "SYSTEMS",
      "EXPEDITIONS",
      "HORIZON"
    ],
    "principles": [
      "Real assets over fake complexity",
      "Motion has a purpose",
      "Preserve negative space",
      "Mobile is first-class",
      "Reliability beats novelty"
    ]
  },
  "security": {
    "headers": "public/_headers",
    "robots": "public/robots.txt",
    "sitemap": "public/sitemap.xml",
    "favicon": "public/favicon.svg"
  },
  "future_asset_pipeline": {
    "source": "Aura_Borealis_.blend",
    "inspection": "Blender",
    "runtime_format": "GLB",
    "runtime_path": "public/assets/models/mountains/single-mountain-snow.glb",
    "requirement": "Keep the production GLB optimized and within Cloudflare Pages asset limits."
  },
  "rules": [
    "Do not migrate the project from Cloudflare Pages to Workers without deliberate architectural review.",
    "Do not introduce unnecessary frameworks or infrastructure.",
    "Do not replace real environmental assets with generic stock visuals when the intended asset is available.",
    "Do not make the optional hero GLB a hard runtime dependency.",
    "Do not remove mobile performance safeguards.",
    "Do not weaken the Content Security Policy to accommodate unnecessary external dependencies.",
    "Do not manually maintain dist/ as the source of truth.",
    "The source of truth is the main branch source code and public assets."
  ]
}
